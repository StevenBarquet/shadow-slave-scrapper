{
  "name": "minimal-node-typescript-starter",
  "version": "1.0.0",
  "description": "Minimal NodeJS TypeScript Starter",
  "repository": {
    "type": "git",
    "url": "https://github.com/pedrokehl/minimal-node-typescript-starter"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "watch": "tsx watch src/index.ts",
    "build": "tsc",
    "tslint": "tslint -c tslint.json -p tsconfig.json"
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "25.5.0",
    "@typescript-eslint/parser": "8.57.2",
    "eslint": "10.1.0",
    "eslint-plugin-perfectionist": "5.7.0",
    "nodemon": "3.1.14",
    "tslint": "6.1.3",
    "tsx": "4.21.0",
    "typescript": "6.0.2"
  },
  "engines": {
    "node": ">= 25.0.0"
  },
  "dependencies": {
    "puppeteer": "24.40.0"
  }
}
